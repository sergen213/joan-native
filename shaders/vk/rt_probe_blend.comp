#version 460
// DDGI probe update (docs/RAYTRACING.md): one 8x8 workgroup per probe = its 8x8 atlas tile (6x6 octahedral
// interior + 1-texel border). Border texels evaluate the direction of the interior texel they mirror, so the
// tile stays seamless for bilinear filtering without a separate border pass. Irradiance: cosine-weighted mean
// of the rays; depth: mean and mean square of the (clamped) distance with a sharp cosine power (Chebyshev
// visibility). Hysteresis: running mean for the first updates of a probe, then RT.gi_scale.w (0.97). A probe
// that sees back faces with more than 25 % of its rays sits inside geometry and is marked inactive.
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#define RT_STATE_ACCESS
#include "common.glsl"
#include "remaster_vk.glsl"
#include "../common/remaster_common.glsl"
#include "rt_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 3, binding = 10, rgba16f) uniform image2D u_irr_img;
layout(set = 3, binding = 11, rgba16f) uniform image2D u_depth_img;  // rg used
layout(set = 3, binding = 13, std430) readonly buffer ProbeRays { vec4 u_rays[]; };

shared vec4 s_ray[64];
shared vec3 s_dir[64];
shared uint s_back;

vec3 probe_ray(uint i) {  // must match rt_probe_trace.comp
    float n = float(RT.grid_base.w), k = float(i) + 0.5;
    float phi = 6.2831853 * fract(k * 0.618034), cos_t = 1.0 - 2.0 * k / n, sin_t = sqrt(max(1.0 - cos_t * cos_t, 0.0));
    return normalize(mat3(RT.probe_rotation) * vec3(cos(phi) * sin_t, cos_t, sin(phi) * sin_t));
}

ivec2 interior(ivec2 t) {  // DDGI border layout: which interior texel a border texel copies
    bool bx = t.x == 0 || t.x == 7, by = t.y == 0 || t.y == 7;
    if (bx && by) return ivec2(t.x == 0 ? 6 : 1, t.y == 0 ? 6 : 1);
    if (by) return ivec2(7 - t.x, t.y == 0 ? 1 : 6);
    if (bx) return ivec2(t.x == 0 ? 1 : 6, 7 - t.y);
    return t;
}

void main() {
    int probe = int(gl_WorkGroupID.x);
    uint lid = gl_LocalInvocationIndex;
    if (lid == 0u) s_back = 0u;
    barrier();
    s_ray[lid] = u_rays[probe * RT.grid_base.w + int(lid)];
    s_dir[lid] = probe_ray(lid);
    if (s_ray[lid].a < 0.0) atomicAdd(s_back, 1u);
    barrier();

    ivec3 dims = RT.grid_dims.xyz;
    ivec3 slot = ivec3(probe % dims.x, (probe / dims.x) % dims.y, probe / (dims.x * dims.y));
    ivec3 cell = RT.grid_base.xyz + (slot - rt_probe_slot(RT.grid_base.xyz) + dims) % dims;
    ivec4 st = u_probe_state[probe];
    int count = st.xyz == cell ? (st.w & 0xffff) : 0;  // new cell under this slot (volume scrolled): restart
    float hyst = count == 0 ? 0.0 : min(RT.gi_scale.w, 1.0 - 1.0 / float(count + 1));

    ivec2 t = ivec2(gl_LocalInvocationID.xy);
    vec3 dir = oct_decode((vec2(interior(t) - 1) + 0.5) / 6.0 * 2.0 - 1.0);
    vec3 irr = vec3(0.0);
    vec2 mom = vec2(0.0);
    float wi = 0.0, wd = 0.0, maxd = RT.grid_spacing.w;
    for (int i = 0; i < 64; ++i) {
        float c = max(dot(dir, s_dir[i]), 0.0);
        irr += c * s_ray[i].rgb;
        wi += c;
        float dd = min(abs(s_ray[i].a), maxd), w = pow(c, 50.0);
        mom += w * vec2(dd, dd * dd);
        wd += w;
    }
    irr /= max(wi, 1e-4);
    mom = wd > 1e-4 ? mom / wd : vec2(maxd, maxd * maxd);
    ivec2 texel = rt_probe_tile(slot) + t;
    vec3 old_irr = imageLoad(u_irr_img, texel).rgb;
    vec2 old_mom = imageLoad(u_depth_img, texel).rg;
    imageStore(u_irr_img, texel, vec4(mix(irr, old_irr, hyst), 1.0));
    imageStore(u_depth_img, texel, vec4(mix(mom, old_mom, hyst), 0.0, 0.0));

    barrier();  // every invocation read the old state before it changes
    if (lid == 0u) u_probe_state[probe] = ivec4(cell, min(count + 1, 0xffff) | (s_back * 4u > 64u ? kProbeInactive : 0));
}
