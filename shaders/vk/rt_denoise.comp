#version 460
// Denoiser for the ray-traced shadow (signal 0) and reflection (signal 1) images (docs/RAYTRACING.md), "SVGF lite":
//  mode 0 temporal: reproject the previous accumulation through the camera motion (R.prev_view_proj), 4-tap
//         bilinear with per-tap depth/normal/roughness validation, exponential average (1/len, floor 0.15 shadow,
//         0.1 reflection), history clamped to the 3x3 raw neighbourhood (mean +- 2 sigma) so a unit's shadow does
//         not trail where it left (Kabus 22 docs/RAYTRACING.md). a = history length.
//  mode 1 a-trous: 3x3 B-spline kernel at `step` (1, 2, 4), weights from the G-buffer depth, normal, roughness
//         and a luminance distance whose tolerance shrinks with the history length.
// Images (u_img): 0 shadow raw, 1/2 shadow accumulation, 3/4 shadow filter ping-pong, 5..9 the same for reflections.
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#include "common.glsl"
#include "remaster_vk.glsl"
#include "../common/remaster_common.glsl"
#include "rt_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
TEX(6) sampler2D u_depth;
layout(set = 3, binding = 9, rgba16f) uniform image2D u_img[10];
layout(push_constant) uniform Push {
    uint mode, signal;
    int step;
    uint images;  // src | dst << 8 | history << 16
} u_push;

float lum(vec4 c) { return u_push.signal == 0u ? c.r : luma(c.rgb); }
bool valid(vec4 c) { return u_push.signal == 0u || c.a >= 0.0; }

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy), size = ivec2(R.screen.xy);
    if (any(greaterThanEqual(px, size))) return;
    uint src = u_push.images & 0xffu, dst = (u_push.images >> 8) & 0xffu, hist = (u_push.images >> 16) & 0xffu;
    vec4 c = imageLoad(u_img[src], px);
    vec4 g = texelFetch(u_gbuffer, px, 0);
    float d = texelFetch(u_depth, px, 0).r;
    if (!valid(c) || d >= 1.0) {
        imageStore(u_img[dst], px, c);
        return;
    }
    vec3 n = oct_decode(g.xy);

    if (u_push.mode == 0u) {
        vec4 h = vec4(0.0);
        float wsum = 0.0;
        if (RT.prev_camera.w != 0.0) {
            vec3 p = world_from_depth((vec2(px) + 0.5) * R.screen.zw, d);
            vec4 clip = R.prev_view_proj * vec4(p, 1.0);
            vec2 pp = ndc_to_uv(clip.xy / clip.w) * R.screen.xy - 0.5;
            ivec2 p0 = ivec2(floor(pp));
            vec2 f = pp - vec2(p0);
            float expect = distance(p, RT.prev_camera.xyz);
            for (int i = 0; i < 4; ++i) {
                ivec2 o = ivec2(i & 1, i >> 1), q = p0 + o;
                if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
                vec4 gp = texelFetch(u_gbuffer_prev, q, 0);
                if (abs(gp.w - expect) > 0.02 * expect + 1.0 || dot(oct_decode(gp.xy), n) < 0.85 || abs(gp.z - g.z) > 0.1) continue;
                vec4 s = imageLoad(u_img[hist], q);
                if (!valid(s)) continue;
                float w = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
                h += w * s;
                wsum += w;
            }
        }
        float len = 0.0;
        if (wsum > 1e-3) {
            h /= wsum;
            len = h.a;
            {  // clamp the history to the current neighbourhood
                vec3 m1 = vec3(0.0), m2 = vec3(0.0);
                float k = 0.0;
                for (int y = -1; y <= 1; ++y)
                    for (int x = -1; x <= 1; ++x) {
                        vec4 s = imageLoad(u_img[src], clamp(px + ivec2(x, y), ivec2(0), size - 1));
                        if (!valid(s)) continue;
                        m1 += s.rgb;
                        m2 += s.rgb * s.rgb;
                        k += 1.0;
                    }
                m1 /= k;
                vec3 sigma = sqrt(max(m2 / k - m1 * m1, vec3(0.0)));
                h.rgb = clamp(h.rgb, m1 - 2.0 * sigma, m1 + 2.0 * sigma);
            }
        }
        len = min(len + 1.0, 64.0);
        vec4 o = mix(h, c, max(1.0 / len, u_push.signal == 0u ? 0.15 : 0.1));
        imageStore(u_img[dst], px, vec4(o.rgb, len));
        return;
    }

    const float kernel[3] = float[](0.25, 0.5, 0.25);
    float lc = lum(c), sigma = (0.04 + 0.8 / sqrt(max(c.a, 1.0))) * (u_push.signal == 0u ? 1.0 : max(lc, 0.05));
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) {
            ivec2 q = px + ivec2(x, y) * u_push.step;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
            vec4 s = imageLoad(u_img[src], q);
            vec4 gq = texelFetch(u_gbuffer, q, 0);
            if (!valid(s) || texelFetch(u_depth, q, 0).r >= 1.0) continue;
            float w = kernel[x + 1] * kernel[y + 1];
            w *= exp(-abs(gq.w - g.w) / (0.01 * g.w * float(u_push.step) + 0.5));
            w *= pow(max(dot(oct_decode(gq.xy), n), 0.0), 32.0);
            w *= exp(-abs(gq.z - g.z) * 10.0);
            w *= exp(-abs(lum(s) - lc) / sigma);
            sum += w * s;
            wsum += w;
        }
    imageStore(u_img[dst], px, vec4((sum / max(wsum, 1e-6)).rgb, c.a));
}
