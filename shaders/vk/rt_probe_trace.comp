#version 460
// DDGI probe rays (docs/RAYTRACING.md): one workgroup per probe slot, one invocation per ray (kProbeRays = 64).
// Directions: spherical Fibonacci set under this frame's random rotation. Hits are shaded like reflection hits
// (sun with a shadow ray + last frame's probe irradiance = one more bounce per frame); misses see the sky,
// scaled to the Original ambient level. Characters are not traced (kRtMaskProbe). Back faces store a negative,
// shortened distance (probe inside geometry -> classified inactive by rt_probe_blend.comp).
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#include "common.glsl"
#include "remaster_vk.glsl"
#include "../common/remaster_common.glsl"
#include "rt_common.glsl"

layout(local_size_x = 64) in;
layout(set = 3, binding = 13, std430) writeonly buffer ProbeRays { vec4 u_rays[]; };  // rgb radiance, a signed distance

vec3 probe_ray(uint i) {  // spherical Fibonacci, rotated per frame
    float n = float(RT.grid_base.w), k = float(i) + 0.5;
    float phi = 6.2831853 * fract(k * 0.618034), cos_t = 1.0 - 2.0 * k / n, sin_t = sqrt(max(1.0 - cos_t * cos_t, 0.0));
    return normalize(mat3(RT.probe_rotation) * vec3(cos(phi) * sin_t, cos_t, sin(phi) * sin_t));
}

void main() {
    int probe = int(gl_WorkGroupID.x);
    ivec3 dims = RT.grid_dims.xyz;
    ivec3 slot = ivec3(probe % dims.x, (probe / dims.x) % dims.y, probe / (dims.x * dims.y));
    ivec3 cell = RT.grid_base.xyz + (slot - rt_probe_slot(RT.grid_base.xyz) + dims) % dims;  // world cell held by this slot
    vec3 o = vec3(cell) * RT.grid_spacing.xyz;
    vec3 dir = probe_ray(gl_LocalInvocationID.x);
    RtHit h = rt_trace(o, dir, 4000.0, kRtMaskProbe);
    vec4 r;
    if (!h.hit) {
        r = vec4(rt_sky(dir) * RT.gi_scale.rgb, 1e4);
    } else {
        bool front;
        vec3 c = rt_shade_hit(h, dir, 0.44, front);  // cone: 4 pi / 64 sr per ray
        if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);  // one bad ray would poison the probe (and its neighbours) for good
        r = front ? vec4(min(c, vec3(8.0)), h.t) : vec4(0.0, 0.0, 0.0, -0.2 * h.t);
    }
    u_rays[probe * RT.grid_base.w + int(gl_LocalInvocationID.x)] = r;
}
