#version 460
// Ray-traced reflections per scene pixel (docs/RAYTRACING.md): GGX visible-normal samples (Heitz 2018) for
// surfaces up to `max_roughness` (rougher ones keep the prefiltered IBL), hits shaded like the raster path
// (rt_shade_hit, one shadow ray, probe/IBL ambient, original fog over the reflected segment), misses = sky.
// Writes image 5 (rgb radiance, a = 1; a = -1 where not traced); rt_denoise.comp accumulates and filters it.
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#include "common.glsl"
#include "remaster_vk.glsl"
#include "../common/remaster_common.glsl"
#include "rt_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
TEX(6) sampler2D u_depth;
layout(set = 3, binding = 9, rgba16f) uniform writeonly image2D u_img[10];

vec3 sample_vndf(vec3 ve, float a, vec2 u) {
    vec3 vh = normalize(vec3(a * ve.x, a * ve.y, ve.z));
    float lensq = vh.x * vh.x + vh.y * vh.y;
    vec3 t1 = lensq > 0.0 ? vec3(-vh.y, vh.x, 0.0) * inversesqrt(lensq) : vec3(1.0, 0.0, 0.0), t2 = cross(vh, t1);
    float r = sqrt(u.x), phi = 6.2831853 * u.y;
    float p1 = r * cos(phi), p2 = r * sin(phi), s = 0.5 * (1.0 + vh.z);
    p2 = (1.0 - s) * sqrt(1.0 - p1 * p1) + s * p2;
    vec3 nh = p1 * t1 + p2 * t2 + sqrt(max(0.0, 1.0 - p1 * p1 - p2 * p2)) * vh;
    return normalize(vec3(a * nh.x, a * nh.y, max(0.0, nh.z)));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, ivec2(R.screen.xy)))) return;
    float d = texelFetch(u_depth, px, 0).r;
    vec4 g = texelFetch(u_gbuffer, px, 0);
    if (d >= 1.0 || g.z > RT.params.y) {
        imageStore(u_img[5], px, vec4(0.0, 0.0, 0.0, -1.0));
        return;
    }
    vec2 pixel = vec2(px) + 0.5;
    vec3 p = world_from_depth(pixel * R.screen.zw, d);
    vec3 n = oct_decode(g.xy), v = normalize(R.camera_pos.xyz - p);
    if (dot(n, v) < 0.0) n = -n;
    vec3 t = normalize(cross(abs(n.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), n)), b = cross(n, t);
    vec3 ve = vec3(dot(v, t), dot(v, b), dot(v, n));
    float a = max(g.z * g.z, 1e-3);
    float spread = 2.0 / (R.env.y * R.screen.y) + a * 0.5;  // pixel cone + lobe width (texture LOD at the hit)
    vec3 o = p + n * (0.3 + g.w * 1.5e-3);
    int rays = int(RT.params.x);
    vec3 sum = vec3(0.0);
    for (int k = 0; k < rays; ++k) {
        vec3 h = sample_vndf(ve, a, rt_xi(pixel, uint(k) + 7u));
        vec3 r = reflect(-v, t * h.x + b * h.y + n * h.z);
        if (dot(r, n) <= 0.0) r = reflect(-v, n);
        RtHit hit = rt_trace(o, r, 6000.0, kRtMaskAll);
        bool front;
        vec3 c = hit.hit ? rt_fog(rt_shade_hit(hit, r, spread, front), hit.t) : rt_sky(r);
        if (!any(isnan(c)) && !any(isinf(c))) sum += min(c, vec3(8.0));  // firefly clamp (HDR, before tone mapping)
    }
    imageStore(u_img[5], px, vec4(sum / float(rays), 1.0));
}
